# Environment Configuration Template
# Copy this file to .env and update with your values

# Application Environment
NODE_ENV=production

# Google Ads Configuration
# Get your Google Ads client ID from https://www.google.com/adsense
# Format: ca-pub-XXXXXXXXXXXXXXXXX
REACT_APP_GOOGLE_ADS_CLIENT_ID=ca-pub-XXXXXXXXXX

# Ad Slot IDs (Get these from your Google Ads account)
REACT_APP_AD_SLOT_TOP=1234567890
REACT_APP_AD_SLOT_BOTTOM=0987654321
REACT_APP_AD_SLOT_SIDEBAR=1111111111
REACT_APP_AD_SLOT_CONTENT_1=2222222222
REACT_APP_AD_SLOT_CONTENT_2=3333333333
REACT_APP_AD_SLOT_CONTENT_3=4444444444
REACT_APP_AD_SLOT_CONTENT_4=5555555555
REACT_APP_AD_SLOT_CONTENT_5=6666666666

# API Configuration (if backend is implemented)
REACT_APP_API_URL=https://api.economicstorm.com
REACT_APP_API_TIMEOUT=5000

# Analytics (optional)
REACT_APP_GA_TRACKING_ID=UA-XXXXXXXXX-X

# Feature Flags
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_ENABLE_ADS=true
