# Environment Configuration Template
# Copy this file to .env and update with your values

# Application Environment
NODE_ENV=production

# Frontend Configuration
# Google Ads Configuration - Economic Storm Platform
# Publisher ID from Google AdMob/AdSense
# Format: ca-app-pub-XXXXXXXXXXXXXXXXX
REACT_APP_GOOGLE_ADS_CLIENT_ID=ca-app-pub-8167320193401713

# Ad Slot IDs for Economic Storm Platform
# Banner Ad (eco-Storm)
REACT_APP_AD_SLOT_TOP=1979671399
# Implant Advertising (alshameel)
REACT_APP_AD_SLOT_BOTTOM=9387388128
# Customer Ads
REACT_APP_AD_SLOT_SIDEBAR=3803888958
# For Ad
REACT_APP_AD_SLOT_CONTENT_1=4790216305
# For Developer
REACT_APP_AD_SLOT_CONTENT_2=9934183032
# Partner
REACT_APP_AD_SLOT_CONTENT_3=5228651260
# Additional slots (reusing for redundancy)
REACT_APP_AD_SLOT_CONTENT_4=1979671399
REACT_APP_AD_SLOT_CONTENT_5=9387388128

# Backend API Configuration
REACT_APP_API_URL=http://localhost:5000/api/v1
REACT_APP_API_TIMEOUT=5000

# Analytics (optional)
REACT_APP_GA_TRACKING_ID=UA-XXXXXXXXX-X

# Feature Flags
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_ENABLE_ADS=true
REACT_APP_ENABLE_AI=true
