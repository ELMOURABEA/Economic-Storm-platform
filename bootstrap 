resource "random_id" "state_suffix" {
  byte_length = 2
}

resource "aws_s3_bucket" "tf_state" {
  bucket = "${var.project_name}-terraform-state-${random_id.state_suffix.hex}"
  acl    = "private"

  force_destroy = false

  versioning {
    enabled = true
  }

  server_side_encryption_configuration {
    rule {
      apply_server_side_encryption_by_default {
        sse_algorithm = "AES256"
      }
    }
  }

  lifecycle_rule {
    id      = "keep-recent"
    enabled = true

    noncurrent_version_expiration {
      days = 30
    }
  }

  tags = merge(var.tags, {
    "Name" = "${var.project_name}-tfstate"
  })
}

resource "aws_s3_bucket_public_access_block" "tf_state_block" {
  bucket                  = aws_s3_bucket.tf_state.id
  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

resource "aws_dynamodb_table" "tf_locks" {
  name         = "${var.project_name}-terraform-locks-${random_id.state_suffix.hex}"
  billing_mode = "PAY_PER_REQUEST"
  hash_key     = "LockID"

  attribute {
    name = "LockID"
    type = "S"
  }

  tags = merge(var.tags, {
    "Name" = "${var.project_name}-tf-locks"
  })
}

output "tfstate_s3_bucket" {
  description = "S3 bucket created for Terraform remote state"
  value       = aws_s3_bucket.tf_state.id
}

output "tfstate_dynamodb_table" {
  description = "DynamoDB table name for Terraform state locking"
  value       = aws_dynamodb_table.tf_locks.name
}
{terraform {
  backend "s3" {
    bucket         = "REPLACE_WITH_CREATED_BUCKET_NAME"   # e.g., economic-storm-terraform-state-ab12
    key            = "dr-bot/terraform.tfstate"           # path within the bucket for the state file
    region         = "us-east-1"
    encrypt        = true
    dynamodb_table = "REPLACE_WITH_CREATED_DDB_TABLE"     # e.g., economic-storm-terraform-locks-ab12
  }
}
